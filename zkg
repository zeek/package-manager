#! /usr/bin/env python3

# https://pypi.org/project/argcomplete/#global-completion
# PYTHON_ARGCOMPLETE_OK

import sys

import zeekpkg


def main() -> None:
    parser = zeekpkg.cli.argparser()
    args = parser.parse_args()

    zeekpkg.logs.configure(args.verbose)

    configfile = zeekpkg.CONFIG.find_configfile(args)

    # Treat explicitly requested config files that don't exist as an error:
    if args.configfile and configfile != args.configfile:
        zeekpkg.UI.error(f'invalid config file "{args.configfile}"')
        sys.exit(1)

    zeekpkg.CONFIG.reset(args)
    zeekpkg.CONFIG.update_from_file(configfile)
    zeekpkg.CONFIG.update_from_args(args)

    manager = zeekpkg.manager.create_manager()

    if manager is None:
        zeekpkg.UI.error("Permission problems prevent zkg from creating internal state")
        if not args.user:
            zeekpkg.UI.error(
                "Consider the --user flag to manage zkg state via {home_config_dir()}/config",
            )
        sys.exit(1)

    for name, url in zeekpkg.CONFIG.items("sources"):
        if err := manager.add_source(name, url):
            print(
                f'warning: skipped using package source named "{name}" ({url}): {err}',
                file=sys.stderr,
            )

    args.run_cmd(manager, args)


if __name__ == "__main__":
    main()
    sys.exit(0)

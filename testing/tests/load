# The same skip is still recorded at debug level when verbose logging is enabled.
# --force is explicit because the test wrapper only injects it when argv[1] is "install".
# @TEST-EXEC: zkg -vvv install --force i-have-no-scripts 2>install_no_scripts_debug.err
# @TEST-EXEC: grep -q 'DEBUG.*no __load__.zeek in implicit script_dir' install_no_scripts_debug.err
